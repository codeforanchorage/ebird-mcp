# Rename this to `backend.tf` after running `scripts/setup-backend.sh`,
# which creates the S3 bucket and DynamoDB lock table and generates a
# pre-filled `backend.tf` automatically. The example below shows what
# `setup-backend.sh` produces — you do not normally need to edit by hand.
#
# terraform {
#   backend "s3" {
#     bucket         = "ebird-mcp-tfstate-<account-id>-<region>"
#     key            = "terraform.tfstate"
#     region         = "us-west-2"
#     dynamodb_table = "terraform-state-lock"
#     encrypt        = true
#   }
# }

# Python
__pycache__/
*.py[codz]
*.so
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
.python-version

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local-only files containing secrets / personal config
# (commit *.example versions instead; the real ones stay local)
config.yaml
.mcp.json
.env
.env.*

# Lambda deployment artifacts (rebuilt by scripts/deploy.sh)
.deploy/
*.zip
terraform/aws/lambda-deployment.zip
terraform/aws/config.yaml

# Bundled eBird taxonomy snapshot — refreshed at deploy time by
# scripts/refresh_taxonomy.py. ~5-10 MB; rebuilt fresh on every deploy.
plugins/ebird/data/taxonomy.json

# Terraform — local state and account-specific backend wiring.
# .terraform.lock.hcl IS intentionally NOT ignored; commit it so
# provider versions are reproducible across machines.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
terraform/aws/backend.tf

# Local working / scratch
.scratch/

# Claude Code per-user / per-machine settings
.claude/settings.local.json

# MkDocs local build output (deployed via GitHub Actions to gh-pages branch)
/site/
